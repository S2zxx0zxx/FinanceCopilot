# ═══════════════════════════════════════════════════════════════════════════
# FinCopilot v10 — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# Never commit the actual `.env` file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                          # development | production
BACKEND_PORT=3001                             # Backend (Node) port — default 3001 (landing uses 3000)
# PORT=3001                                   # Override BACKEND_PORT (some hosts set PORT)
BACKEND_URL=http://localhost:3001             # Used by the landing to verify session + by Vite dev proxy

# ── Auth — Firebase (server-side Admin SDK) ─────────────────────────────────
# Service-account credentials. NEVER expose these to the browser.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Auth mode — 'production' (default) uses real Firebase; 'mock' uses dev bypass.
# MOCK IS FORBIDDEN outside NODE_ENV=test/dev per INV-SEC-001.
AUTH_MODE=production

# ── Auth — Firebase (client-side web config) ───────────────────────────────
# These ARE safe to expose to the browser (Firebase's public config).
# The backend serves them at /api/v1/auth/config for the SPA to init Firebase.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ── Database — PostgreSQL ───────────────────────────────────────────────────
# Money is stored as integer paise. See 06_DOMAIN_MODEL.md.
DATABASE_URL=postgres://user:password@localhost:5432/fincopilot

# ── AI Gateway — OmniRouter ─────────────────────────────────────────────────
# Multi-model router (Gemini, Claude, OpenAI, etc). See 09_AI_GATEWAY_SPEC.md.
OMNIROUTER_API_KEY=your_omnirouter_key_here

# ── Storage — Cloudflare R2 (raw uploaded statements) ──────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=fincopilot-statements-dev

# ── Queue — Cloudflare Queues (async ingestion/normalization jobs) ──────────
CF_QUEUE_API_TOKEN=your_cf_api_token
CF_ACCOUNT_ID=your_account_id
CF_QUEUE_NAME=fincopilot-jobs

# ── Account Aggregator — Setu (Indian AA framework, RBI-regulated) ──────────
# Sandbox for dev, production URL + real credentials for prod.
SETU_BASE_URL=https://sandbox.setu.co
SETU_FIU_ID=your-fiu-id
SETU_API_KEY=your-setu-api-key
SETU_API_SECRET=your-setu-api-secret

# ── Internal (webhooks between backend services) ────────────────────────────
INTERNAL_WEBHOOK_TOKEN=generate-a-long-random-string

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# In production: the landing domain + the app domain (if separate).
CORS_ORIGIN=https://fincopilot.ai,https://app.fincopilot.ai

# ── Analytics (optional — server-side GA4 Measurement Protocol) ────────────
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_api_secret
# POSTHOG_KEY=your_posthog_key
