# ═══════════════════════════════════════════════════════════════════════════
# FinCopilot — Root Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the actual `.env` file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# ── Auth — Clerk ───────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
AUTH_MODE=production

# ── Database — PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/fincopilot

# ── AI Gateway ─────────────────────────────────────────────────────────────
OMNIROUTER_API_URL=https://api.omnirouter.com/v1
OMNIROUTER_API_KEY=your_omnirouter_key_here
GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
AI_KILL_SWITCH=false

# ── Storage — Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=fincopilot-statements-dev
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ── Queue — Cloudflare Queues ──────────────────────────────────────────────
CF_QUEUE_API_TOKEN=your_cf_queue_api_token
CF_ACCOUNT_ID=your_account_id
CF_QUEUE_NAME=fincopilot-jobs

# ── Account Aggregator — Setu AA Gateway v2 ────────────────────────────────
# Keep disabled until your Bridge sandbox product and OAuth key are ready.
SETU_AA_ENABLED=false
SETU_PRODUCTION=false

# Current Setu AA Gateway hosts.
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_URL=https://uat.setu.co/api/v2/auth/token
SETU_API_PREFIX=/v2

# The Bridge → Org settings → API keys → OAuth. Never expose these client-side.
SETU_CLIENT_ID=your_setu_oauth_client_id
SETU_CLIENT_SECRET=your_setu_oauth_client_secret

# The Bridge → Account Aggregator Data product → Product/instance ID.
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id

# Optional emergency/testing override. Normally leave empty so the backend
# obtains/caches OAuth tokens from SETU_CLIENT_ID + SETU_CLIENT_SECRET.
# SETU_ACCESS_TOKEN=

# Generate a long random value. Configure the Bridge notification callback as:
# https://api.yourdomain.com/api/v1/aa/webhook?token=<same-secret>
# Do not put the real secret in Git or screenshots.
SETU_WEBHOOK_SECRET=generate-a-long-random-setu-webhook-secret

# Recommended for FinCopilot proactive updates. Enable the matching Auto-Fetch
# option in The Bridge as well. Set false to use manual data sessions instead.
SETU_AUTO_FETCH=true

# Where Setu returns the user after the consent review UI.
SETU_REDIRECT_URL=http://localhost:3000/accounts/connect/callback

# Production switch example (do not copy until Setu production onboarding):
# SETU_PRODUCTION=true
# SETU_BASE_URL=https://fiu.setu.co
# SETU_AUTH_URL=https://prod.setu.co/api/v2/auth/token

# ── Internal webhooks ──────────────────────────────────────────────────────
INTERNAL_WEBHOOK_TOKEN=generate-a-long-random-string

# ── Privacy salts ──────────────────────────────────────────────────────────
CONSENT_HASH_SALT=generate-a-random-salt
TELEMETRY_SALT=generate-another-random-salt

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ── Analytics (optional) ───────────────────────────────────────────────────
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_api_secret
# POSTHOG_KEY=your_posthog_key
