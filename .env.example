# ═══════════════════════════════════════════════════════════════════════════
# FinCopilot — Root Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the actual `.env` file.
#
# This file is consumed by:
#   • backend/          (Node + Express API on :3001, reads via backend/config/env.js)
#   • frontend/         (Next.js 16 authenticated SPA, see frontend/.env.example)
#   • fincopilot-landing/ (Next.js 16 marketing site on :3002)
#
# All three apps share these variables when run via `npm run dev:all` (dev.js).
# Frontend-specific overrides live in `frontend/.env.example`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                          # development | production
BACKEND_PORT=3001                             # Backend (Node) port — landing uses 3002
# PORT=3001                                   # Override BACKEND_PORT (some hosts set PORT)
BACKEND_URL=http://localhost:3001             # Used by landing + frontend to call the API

# ── Auth — Clerk (server-side secret) ──────────────────────────────────────
# NEVER expose CLERK_SECRET_KEY to the browser. Backend uses it to verify
# session tokens via @clerk/backend.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ── Auth — Clerk (client-side publishable key) ──────────────────────────────
# Safe to expose to the browser. Both frontend + landing use the same key.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Frontend (Next.js) Clerk route overrides — defaults shown.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Frontend API base URL (where the backend is reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Auth mode — 'production' (default) uses real Clerk; 'mock' uses dev bypass
# (MOCK IS FORBIDDEN outside NODE_ENV=test/dev per INV-SEC-001).
AUTH_MODE=production

# ── Database — PostgreSQL ───────────────────────────────────────────────────
# Money is stored as integer paise. See docs/adrs/ADR-003-money-precision-currency-handling.md.
DATABASE_URL=postgres://user:password@localhost:5432/fincopilot

# ── AI Gateway ──────────────────────────────────────────────────────────────
# OmniRouter (multi-model router — Gemini, Claude, OpenAI, etc).
# See docs/adrs/ADR-004-ai-gateway-provider-abstraction.md.
OMNIROUTER_API_URL=https://api.omnirouter.com/v1
OMNIROUTER_API_KEY=your_omnirouter_key_here
# OR ZAI adapter (Gemini direct fallback)
GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here

# AI kill-switch — set to 'true' to disable all AI gateway calls
# (returns 503 from /api/v1/ai/*). Use during incidents.
AI_KILL_SWITCH=false

# ── Storage — Cloudflare R2 (raw uploaded statements) ──────────────────────
# R2_ENDPOINT_URL is REQUIRED by R2StorageAdapter at boot — without it the
# adapter silently skips client construction.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=fincopilot-statements-dev
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ── Queue — Cloudflare Queues (async ingestion/normalization jobs) ──────────
# NOTE: the var is CF_QUEUE_API_TOKEN (NOT CF_API_TOKEN) — the queue adapter
# reads this exact name. Mismatch breaks queue integration silently.
CF_QUEUE_API_TOKEN=your_cf_queue_api_token
CF_ACCOUNT_ID=your_account_id
CF_QUEUE_NAME=fincopilot-jobs

# ── Account Aggregator — Setu (Indian AA framework, RBI-regulated) ──────────
# Sandbox for dev; production URL + real credentials for prod.
SETU_BASE_URL=https://sandbox.setu.co
SETU_FIU_ID=your-fiu-id
SETU_API_KEY=your-setu-api-key
SETU_API_SECRET=your-setu-api-secret

# ── Internal (webhooks between backend services) ────────────────────────────
# No hardcoded fallback in code — must be set or internal webhooks 401.
INTERNAL_WEBHOOK_TOKEN=generate-a-long-random-string

# ── Privacy salts (REQUIRED in production) ─────────────────────────────────
# CONSENT_HASH_SALT  — deterministic hashing of AA consent handles
# TELEMETRY_SALT     — salted hashing of telemetry identifiers (privacy)
# In production, telemetry.js fails-closed if TELEMETRY_SALT is missing.
CONSENT_HASH_SALT=generate-a-random-salt
TELEMETRY_SALT=generate-another-random-salt

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# In production: the landing domain + the app domain (if separate).
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ── Analytics (optional — server-side GA4 Measurement Protocol) ────────────
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_api_secret
# POSTHOG_KEY=your_posthog_key
