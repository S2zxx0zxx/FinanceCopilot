# FinCopilot v10 — Production Caddyfile
# ─────────────────────────────────────────────────────────────────────────────
# Topology:
#   :443 (auto-TLS) or :81 (sandbox) receives ALL traffic.
#   Routing priority (first match wins; handle blocks are mutually exclusive):
#     (0) ?XTransformPort=<port> → reverse-proxy to localhost:<port>  [sandbox mini-services]
#     (1) /app/api/*  → backend (Node, :3001)  [app's own backend API if separate]
#     (2) /api/v1/*   → backend (Node, :3001)  [app's API — has /auth/config, /financial-state/*, etc.]
#     (3) /api/session, /api/cta, /api/health → landing (Next.js, :3002)  [landing's own bridge routes]
#     (4) /app/*     → backend (Node, :3001)  [backend serves the SPA via express.static + catch-all]
#     (5) /*         → landing (Next.js, :3002)  [marketing page]
#
# Why /app/* → backend (not file_server):
#   The backend already has `express.static(frontendPath)` + SPA catch-all `app.get('*')`.
#   Routing /app/* to the backend lets the backend serve the SPA AND handle /api/v1/* under
#   the same origin/cookie scope. The backend's catch-all returns index.html for any
#   non-/api path, so SPA client-side routing (e.g. /app/money, /app/ai/chat) works on refresh.
#
#   NOTE: The backend's SPA catch-all matches `*`. To make it serve `/app/*` content,
#   either:
#     (a) Set FRONTEND_BASE_PATH=/app on the backend so its express.static + catch-all
#         prefix-strip /app, OR
#     (b) Use Caddy to strip /app before proxying (uri strip_prefix /app) so the backend
#         sees /, /money, /ai/chat etc. and its existing catch-all works unchanged.
#   We use (b) — strip_prefix — so the backend code is NOT modified.
#
# Cookie scope:
#   All cookies are set with Path=/ so they span / (landing) + /app/* (SPA) + /api/* (both).
#   SameSite=Lax. Secure in prod. HttpOnly for the session cookie.
# ─────────────────────────────────────────────────────────────────────────────

# For production, replace :81 with your domain (e.g. fincopilot.ai) to enable auto-TLS.
# Sandbox gateway uses :81 — DO NOT change this in the sandbox.
:81 {
    encode zstd gzip

    # ── (0) Sandbox mini-service mechanism — KEEP UNCHANGED ──
    @transform_port_query {
        query XTransformPort=*
    }
    handle @transform_port_query {
        reverse_proxy localhost:{query.XTransformPort} {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # ── (1) App's own backend API under /app/api/* (if it ever diverges from /api/v1/*) ──
    # Strip /app so the backend sees /api/...
    @appApi path /app/api/*
    handle @appApi {
        uri strip_prefix /app
        reverse_proxy localhost:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            lb_try_duration 5s
            lb_try_interval 100ms
        }
    }

    # ── (2) App API v1 — backend (Node :3001) ──
    # /api/v1/auth/config, /api/v1/financial-state/*, /api/v1/accounts, etc.
    @apiV1 path /api/v1/*
    handle @apiV1 {
        reverse_proxy localhost:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            lb_try_duration 5s
            lb_try_interval 100ms
        }
    }

    # ── (3) Landing's bridge API routes — landing (Next.js :3002) ──
    # /api/session, /api/cta, /api/health (NOT /api/v1/*)
    @landingApi path /api/session /api/cta /api/health /api/session/* /api/cta/* /api/health/*
    handle @landingApi {
        reverse_proxy localhost:3002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            lb_try_duration 5s
            lb_try_interval 100ms
        }
    }

    # ── (4) The SPA app at /app/* — served by the backend (Node :3001) ──
    # Strip /app so the backend's existing express.static + SPA catch-all (mounted at /)
    # handle the request unchanged. The backend serves frontend/public/* at root, so
    # /app/ → /, /app/money → / (catch-all returns index.html), /app/styles/app.css → /styles/app.css.
    @appRoot path /app /app/*
    handle @appRoot {
        uri strip_prefix /app
        reverse_proxy localhost:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            # Preserve the original /app/* path so the SPA's BASE_PATH detection works.
            # The backend serves index.html for any non-/api path; the SPA's app.js reads
            # window.location.pathname (which is /app/money) and strips BASE_PATH itself.
            header_up X-Original-URI {uri}
            lb_try_duration 5s
            lb_try_interval 100ms
        }
    }

    # ── (5) Everything else → landing (Next.js :3002) ──
    handle {
        reverse_proxy localhost:3002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            lb_try_duration 5s
            lb_try_interval 100ms
        }
    }

    # ── (6) Custom 502 page ──
    handle_errors {
        @is502 expression {err.status_code} == 502
        handle @is502 {
            root * ./public/errors
            rewrite * /502.html
            file_server
        }
    }
}
