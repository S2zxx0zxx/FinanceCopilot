# ═══════════════════════════════════════════════════════════════════════════
# FinCopilot — Environment Configuration
# Copy to .env and fill real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# ── Auth — Clerk (ACTIVE provider) ─────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Frontend public Clerk config
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Frontend API URL (where backend is reachable from browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Database — PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/fincopilot

# ── AI Gateway ─────────────────────────────────────────────────────────────
# OmniRouter (multi-model router)
OMNIROUTER_API_KEY=your_omnirouter_key
# OR ZAI adapter (Gemini/OpenAI fallback)
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key

# ── Storage — Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=fincopilot-statements-dev
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ── Queue — Cloudflare Queues ──────────────────────────────────────────────
CF_QUEUE_API_TOKEN=your_cf_token
CF_ACCOUNT_ID=your_cf_account_id
CF_QUEUE_NAME=fincopilot-jobs

# ── Account Aggregator — Setu (Indian AA framework) ───────────────────────
SETU_BASE_URL=https://sandbox.setu.co
SETU_FIU_ID=your_fiu_id
SETU_API_KEY=your_setu_key
SETU_API_SECRET=your_setu_secret

# ── Security ───────────────────────────────────────────────────────────────
INTERNAL_WEBHOOK_TOKEN=your_secure_random_token
CONSENT_HASH_SALT=your_random_salt
TELEMETRY_SALT=your_telemetry_salt
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ── Analytics (optional) ───────────────────────────────────────────────────
GA4_MEASUREMENT_ID=
POSTHOG_KEY=
